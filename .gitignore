# ============================================================
# المنصة الطبية — السنة التحضيرية (Pre12)
# .gitignore — ملفات التطوير والبناء والأدوات المحلية
# ============================================================

# ── الاعتماديات ───────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/versions
.yarn-integrity

# ── مخرجات البناء ─────────────────────────────────────────
# dist/ هو مخرَج البناء الوحيد (يُبنى بـ "npm run build").
dist/

# ⭐ v5.1.1 — صفحات HTML المولَّدة تعيش في dist/ فقط.
#    الجذر يبقى نظيفاً: لا ملفات مبنية ولا نسخ شبح.
/*.html
!widget_reference_final.html
build/
.cache/
.temp/
tmp/

# ── ملفات تطوير داخلية (لا تُرفع إلى GitHub) ──────────────
# ملاحظات المهام والمراحل
prompt*.txt
# ملفات الاختبار
master.test.js
*.test.js
*.spec.js
__tests__/
tests/
coverage/
.nyc_output/
# النسخة الأصلية المرجعية للتصميم (محلية فقط)
tools/_orig/

# ملاحظة: مجلد supabase/ (مخططات قاعدة البيانات) مقصود رفعه إلى
# GitHub لأنه يوثّق مخطط القاعدة — وهو مستثنى من dist/ عبر EXCLUDE_TOP
# في build.js فلا يُنشر على الويب.

# ── الأسرار ومتغيرات البيئة ───────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets.json
service-account*.json
supabase-service-role*
.vscode/settings.json
.idea/

# ── نظام التشغيل والمحرّرات ──────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.swp
*.swo
*~

# ── السجلّات ──────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# ── Android / Capacitor ────────────────────────────────────
# نرفع مشروع الأندرويد كاملاً (كي يبني GitHub Actions الـ APK)،
# لكن بلا مخرجات البناء ولا ملفات Gradle المؤقتة.
android/.gradle/
android/build/
android/app/build/
android/capacitor-cordova-android-plugins/build/
android/local.properties
android/.idea/
android/*.iml
android/app/*.iml
android/app/release/
android/app/debug/
*.keystore
!debug.keystore
android/app/google-services.json.enc

# أداة Firebase MCP (ملف محلي)
opencode.json
firebase.json
pre12-medical-firebase-adminsdk-*.json
send-test.js
