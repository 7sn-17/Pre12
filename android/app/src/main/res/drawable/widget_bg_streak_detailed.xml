<?xml version="1.0" encoding="utf-8"?>
<!--
  Phase W8 — the 4×2 streak card: midnight slate with a subtle red ember glow
  behind the flame side, and a hairline edge that separates it from the
  wallpaper without shouting.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF0F172A" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerColor="#1AE44444"
                android:centerX="0.16"
                android:centerY="0.46"
                android:endColor="#000F172A"
                android:gradientRadius="130dp"
                android:startColor="#4DEF4444"
                android:type="radial" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="28dp" />
            <stroke
                android:width="1dp"
                android:color="#1FFFFFFF" />
        </shape>
    </item>
</layer-list>
