<?xml version="1.0" encoding="utf-8"?>
<!-- Phase W6 — split streak card: ember glow on the number side, quiet week map. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF0F172A" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerColor="#1FF97316"
                android:centerX="0.2"
                android:centerY="0.45"
                android:endColor="#000F172A"
                android:gradientRadius="120dp"
                android:startColor="#59EF4444"
                android:type="radial" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="28dp" />
            <stroke
                android:width="1dp"
                android:color="#1FFFFFFF" />
        </shape>
    </item>
</layer-list>
