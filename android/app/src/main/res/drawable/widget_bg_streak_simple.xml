<?xml version="1.0" encoding="utf-8"?>
<!-- Phase W6 — midnight card + a red ember glow behind the streak number. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF0F172A" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerColor="#26F97316"
                android:centerX="0.5"
                android:centerY="0.16"
                android:endColor="#000F172A"
                android:gradientRadius="150dp"
                android:startColor="#73EF4444"
                android:type="radial" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="28dp" />
            <stroke
                android:width="1dp"
                android:color="#1FFFFFFF" />
        </shape>
    </item>
</layer-list>
