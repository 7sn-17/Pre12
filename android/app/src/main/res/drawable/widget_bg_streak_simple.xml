<?xml version="1.0" encoding="utf-8"?>
<!--
  Phase W7 — the 1×1 streak badge: midnight card, 24 dp radius, 1 dp red border
  (widget_reference_final.html `.widget-streak-1x1`). No glow: at 70 dp a large
  radial highlight only muddies the number.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FF0F172A" />
    <corners android:radius="24dp" />
    <stroke
        android:width="1dp"
        android:color="#FFEF4444" />
</shape>
