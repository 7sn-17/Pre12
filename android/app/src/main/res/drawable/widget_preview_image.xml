        android:fillColor="#FFFFFFFF"
        android:pathData="M218,84 A6,6 0 1 0 230,84 A6,6 0 1 0 218,84 Z"
        android:strokeColor="#FF94A3B8"
        android:strokeWidth="1.5" />
    <path
        android:fillColor="#FFE2E8F0"
        android:pathData="M16,80 H176 A3,3 0 0 1 176,86 H16 A3,3 0 0 1 16,80 Z" />

    <!-- Row 3 · open -->
    <path
        android:fillColor="#FFFFFFFF"
