<?xml version="1.0" encoding="utf-8"?>
<!-- Phase W7 — picker preview for «ملاحظاتي» (violet sticky). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:orientation="horizontal"
    android:padding="4dp">
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/widget_bg_sticky_note"
        android:orientation="vertical"
        android:paddingStart="9dp"
        android:paddingTop="18dp"
        android:paddingEnd="9dp"
        android:paddingBottom="4dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content" android:layout_weight="1"
        android:fontFamily="@font/tajawal_bold"
        android:text="ملاحظاتي"
        android:textColor="#FF6B21A8"
        android:textSize="18sp" />
            <TextView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="@drawable/widget_round_violet"
                android:fontFamily="@font/tajawal_bold"
                android:gravity="center"
                android:text="@string/widget_preview_plus"
                android:textColor="#FF6B21A8"
                android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/tajawal_bold"
            android:text="✦"
            android:textColor="#FFA855F7"
            android:textSize="9sp" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_weight="1"
            android:fontFamily="@font/tajawal_regular"
            android:text="@string/widget_preview_note_1"
            android:textColor="#FF1E293B"
            android:textSize="14sp" />
    </LinearLayout><LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/tajawal_bold"
            android:text="✦"
            android:textColor="#FFA855F7"
            android:textSize="9sp" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_weight="1"
            android:fontFamily="@font/tajawal_regular"
            android:text="@string/widget_preview_note_2"
            android:textColor="#FF1E293B"
            android:textSize="14sp" />
    </LinearLayout><LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/tajawal_bold"
            android:text="✦"
            android:textColor="#FFA855F7"
            android:textSize="9sp" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_weight="1"
            android:fontFamily="@font/tajawal_regular"
            android:text="@string/widget_preview_note_3"
            android:textColor="#FF1E293B"
            android:textSize="14sp" />
    </LinearLayout>
    </LinearLayout>
</LinearLayout>
