<?xml version="1.0" encoding="utf-8"?>
<!-- Phase W7 — picker preview for the 1×1 «سلسلة الأيام» badge. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:background="@drawable/widget_bg_streak_simple"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="4dp">

    <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:contentDescription="@null"
        android:src="@drawable/widget_ic_flame"
        android:tint="#FFF97316" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/tajawal_extrabold"
        android:maxLines="1"
        android:text="@string/widget_preview_streak_number"
        android:textColor="#FFFFFFFF"
        android:textSize="32sp" />
</LinearLayout>
