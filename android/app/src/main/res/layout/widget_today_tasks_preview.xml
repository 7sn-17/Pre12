<?xml version="1.0" encoding="utf-8"?>
<!-- Phase W6 — picker preview for «مهام اليوم». Mirrors TodayTasksWidget.kt. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:background="@drawable/widget_bg_tasks"
    android:orientation="vertical"
    android:padding="13dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content" android:layout_weight="1"
        android:fontFamily="@font/tajawal_bold"
        android:text="@string/widget_today_tasks_label"
        android:textColor="#FFFFFFFF"
        android:textSize="15sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_preview_pill_green"
            android:fontFamily="@font/tajawal_bold"
            android:paddingStart="7dp"
            android:paddingTop="2dp"
            android:paddingEnd="7dp"
            android:paddingBottom="2dp"
            android:text="@string/widget_today_tasks_preview_count"
            android:textColor="#FF34D399"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <FrameLayout
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:background="@drawable/widget_circle_done">
            <ImageView
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/widget_ic_check"
                android:tint="#FFFFFFFF" />
        </FrameLayout>
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="@font/tajawal_regular"
            android:text="@string/widget_today_tasks_preview_task_done"
            android:textColor="#FF94A3B8"
            android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:background="@drawable/widget_circle_empty" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="@font/tajawal_bold"
            android:text="@string/widget_today_tasks_preview_task_open"
            android:textColor="#FFCBD5E1"
            android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:background="@drawable/widget_circle_empty" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="@font/tajawal_bold"
            android:text="@string/widget_today_tasks_preview_task_open2"
            android:textColor="#FFCBD5E1"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
