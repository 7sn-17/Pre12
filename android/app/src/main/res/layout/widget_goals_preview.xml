<?xml version="1.0" encoding="utf-8"?>
<!-- Phase W7 — picker preview for «أهدافي» (blue sticky, progress pills). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:orientation="horizontal"
    android:padding="4dp">
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/widget_bg_sticky_goal"
        android:orientation="vertical"
        android:paddingStart="9dp"
        android:paddingTop="18dp"
        android:paddingEnd="9dp"
        android:paddingBottom="4dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content" android:layout_weight="1"
        android:fontFamily="@font/tajawal_bold"
        android:text="أهدافي"
        android:textColor="#FF075985"
        android:textSize="18sp" />
            <TextView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="@drawable/widget_round_blue"
                android:fontFamily="@font/tajawal_bold"
                android:gravity="center"
                android:text="@string/widget_preview_plus"
                android:textColor="#FF075985"
                android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/tajawal_bold"
            android:text="✦"
            android:textColor="#FF0EA5E9"
            android:textSize="9sp" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_weight="1"
            android:fontFamily="@font/tajawal_bold"
            android:text="@string/widget_preview_goal_1"
            android:textColor="#FF1E293B"
            android:textSize="15sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_preview_pill_blue"
            android:fontFamily="@font/tajawal_bold"
            android:paddingStart="4dp"
            android:paddingTop="1dp"
            android:paddingEnd="4dp"
            android:paddingBottom="1dp"
            android:text="@string/widget_preview_pct"
            android:textColor="#FF0EA5E9"
            android:textSize="9.5sp" />
    </LinearLayout><LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/tajawal_bold"
            android:text="✦"
            android:textColor="#FF0EA5E9"
            android:textSize="9sp" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_weight="1"
            android:fontFamily="@font/tajawal_bold"
            android:text="@string/widget_preview_goal_2"
            android:textColor="#FF1E293B"
            android:textSize="15sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_preview_pill_blue"
            android:fontFamily="@font/tajawal_bold"
            android:paddingStart="4dp"
            android:paddingTop="1dp"
            android:paddingEnd="4dp"
            android:paddingBottom="1dp"
            android:text="@string/widget_preview_pct2"
            android:textColor="#FF0EA5E9"
            android:textSize="9.5sp" />
    </LinearLayout><LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/tajawal_bold"
            android:text="✦"
            android:textColor="#FF0EA5E9"
            android:textSize="9sp" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_weight="1"
            android:fontFamily="@font/tajawal_bold"
            android:text="@string/widget_preview_goal_3"
            android:textColor="#FF1E293B"
            android:textSize="15sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_preview_pill_blue"
            android:fontFamily="@font/tajawal_bold"
            android:paddingStart="4dp"
            android:paddingTop="1dp"
            android:paddingEnd="4dp"
            android:paddingBottom="1dp"
            android:text="@string/widget_preview_pct3"
            android:textColor="#FF0EA5E9"
            android:textSize="9.5sp" />
    </LinearLayout>
    </LinearLayout>
</LinearLayout>
