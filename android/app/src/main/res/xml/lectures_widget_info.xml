<?xml version="1.0" encoding="utf-8"?>
<!--
  Phase W7 — «المحاضرة القادمة / الألبوم» is a 1×1 album tile.

  The subject cover fills the tile (`background-size: cover` in the reference);
  a tap opens the album. Locked to 1×1 so the crop stays square.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_lectures_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="40dp"
    android:minHeight="40dp"
    android:targetCellWidth="1"
    android:targetCellHeight="1"
    android:previewLayout="@layout/widget_lectures_preview"
    android:resizeMode="none"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
