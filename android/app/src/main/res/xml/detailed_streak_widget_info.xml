<?xml version="1.0" encoding="utf-8"?>
<!--
  ⭐⭐ Phase W2 — «سلسلة الأيام · أسبوعي» provider metadata.
  4×2 cells: header + a single 7-day row. 130 dp minimum keeps the day rings at
  a comfortable 26–30 dp.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_detailed_streak_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="250dp"
    android:minHeight="130dp"
    android:minResizeWidth="250dp"
    android:minResizeHeight="130dp"
    android:maxResizeWidth="420dp"
    android:maxResizeHeight="300dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:previewLayout="@layout/widget_detailed_streak_preview"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
