<?xml version="1.0" encoding="utf-8"?>
<!--
  ⭐⭐ Phase W8 — «مهام اليوم» is a WIDE 3×2 card (250×120 dp minimum).

  The user asked for landscape: one wide column with the title, the counter and
  the task rows. targetCellWidth/Height (API 31+) place it exactly on the
  launcher grid; the legacy minWidth/minHeight keep older launchers close. The
  card is still resizable — `TodayTasksWidget` budgets its rows from
  `LocalSize`, and the task text is 16 sp so it survives 1.3× font scale.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_today_tasks_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="250dp"
    android:minHeight="120dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="120dp"
    android:maxResizeWidth="420dp"
    android:maxResizeHeight="340dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:previewLayout="@layout/widget_today_tasks_preview"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
