<?xml version="1.0" encoding="utf-8"?>
<!--
  ⭐⭐ Phase W1 — «مهام اليوم» widget provider metadata.

  Sizing model
  ────────────
  minWidth/minHeight are the legacy cell maths (70dp × cells − 30dp), so
  250×110dp ≈ a 4×2 cell card. targetCellWidth/Height (API 31+) let the
  launcher place it exactly on the grid instead of guessing.

  Corners
  ───────
  The 24 dp radius is applied in `TodayTasksWidget.kt` through
  `GlanceModifier.cornerRadius(24.dp)` + `appWidgetBackground()` — that is the
  only place a widget background can be clipped correctly. `previewImage` /
  `previewLayout` below are already drawn rounded so the picker matches.

  Updates
  ───────
  30 minutes is the platform minimum. It is only a safety net: the app pushes
  a refresh through `capacitor-widget-bridge` whenever tasks change, and the
  receiver also runs on boot and on resize.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_today_tasks_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="250dp"
    android:minHeight="130dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="130dp"
    android:maxResizeWidth="420dp"
    android:maxResizeHeight="280dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:previewImage="@drawable/widget_preview_image"
    android:previewLayout="@layout/widget_today_tasks_preview"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
