<?xml version="1.0" encoding="utf-8"?>
<!--
  Phase W7 — «سلسلة الأيام» is a 1×1 badge and nothing else.

  `resizeMode="none"` locks it to one cell: the design is a flame + a 32 sp
  number, and every larger size would only add empty space. Long-press → resize
  is intentionally unavailable.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_simple_streak_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="40dp"
    android:minHeight="40dp"
    android:targetCellWidth="1"
    android:targetCellHeight="1"
    android:previewLayout="@layout/widget_simple_streak_preview"
    android:resizeMode="none"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
