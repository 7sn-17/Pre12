<?xml version="1.0" encoding="utf-8"?>
<!--
  Phase W6 — «سلسلة الأيام» (simple streak), 2×2.

  The approved design is a square trophy card: flame + 58 pt number + seven
  dots. 110 dp is the platform's 2-cell minimum; below that the widget drops
  the dots and the flame instead of clipping (see SimpleStreakWidget.kt).
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_simple_streak_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:maxResizeWidth="300dp"
    android:maxResizeHeight="300dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:previewLayout="@layout/widget_simple_streak_preview"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
