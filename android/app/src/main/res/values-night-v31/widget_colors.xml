    <color name="widget_color_on_surface">@android:color/system_neutral1_100</color>
    <color name="widget_color_surface_variant">@android:color/system_neutral2_700</color>
    <color name="widget_color_on_surface_variant">@android:color/system_neutral2_200</color>
    <color name="widget_color_outline">@android:color/system_neutral2_400</color>

    <color name="widget_color_inverse_on_surface">@android:color/system_neutral1_800</color>
