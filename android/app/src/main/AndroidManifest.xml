<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- ⭐⭐ Phase W4 — روابط الودجات العميقة:
                 pre12://tasks · pre12://streak · pre12://notes · pre12://goals
                 تُقرأ عبر @capacitor/app (getLaunchUrl + appUrlOpen). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="pre12" />
            </intent-filter>

            <!-- ⭐ روابط تسجيل الدخول (تأكيد البريد / استعادة كلمة المرور).
                 com.pre12.medical://login-callback -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="com.pre12.medical"
                    android:host="login-callback" />
            </intent-filter>

        </activity>

        <!-- ⭐⭐ Phase W1 — «مهام اليوم» home-screen widget (Jetpack Glance).
             The receiver is not exported: only the system (AppWidgetService)
             sends APPWIDGET_UPDATE. `today_tasks_widget_info.xml` carries the
             size grid, preview and refresh policy. -->
        <receiver
            android:name=".widgets.TodayTasksWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_today_tasks_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_tasks_widget_info" />
        </receiver>

        <!-- ⭐⭐ Phase W2 — «سلسلة الأيام» -->
        <receiver
            android:name=".widgets.SimpleStreakWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_simple_streak_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/simple_streak_widget_info" />
        </receiver>

        <!-- ⭐⭐ Phase W2 — «سلسلة الأيام · أسبوعي» -->
        <receiver
            android:name=".widgets.DetailedStreakWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_detailed_streak_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/detailed_streak_widget_info" />
        </receiver>

        <!-- ⭐⭐ Phase W2 — «ملاحظاتي وأهدافي» -->
        <receiver
            android:name=".widgets.NotesWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_notes_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/notes_widget_info" />
        </receiver>

        <!-- ⭐⭐ Phase W5 — variant B: goals only. -->
        <receiver
            android:name=".widgets.GoalsWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_goals_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/goals_widget_info" />
        </receiver>

        <!-- ⭐⭐ Phase W5 — variant C: notes only. -->
        <receiver
            android:name=".widgets.NotesOnlyWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_notes_only_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/notes_only_widget_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- ⭐⭐ أيقونة الإشعارات الافتراضية: سمّاعة طبية بالأبيض -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_icon" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_color" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="medapp_reminders" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- ⭐ Android 13+ : إذن عرض الإشعارات (يُطلب من المستخدم) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ⭐ إعادة تشغيل الاستقبال بعد إعادة تشغيل الجهاز (FCM) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
</manifest>
